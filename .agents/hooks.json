{
  "anti-hang-watchdog": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/anti_hang_watchdog.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent|schedule|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/anti_hang_watchdog.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/anti_hang_watchdog.py",
        "timeout": 10
      }
    ]
  }
}
