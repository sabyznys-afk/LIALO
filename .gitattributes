# Enforce LF line endings for text/Godot files across Windows & Unix
* text=auto eol=lf

*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.glb binary
*.ogg binary
*.wav binary
*.ttf binary
*.pdf binary
*.blend binary
